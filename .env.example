# ==============================================================================
# ANVAYA - Configuration Environment Variables (.env)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For production, obtain your connection string from MongoDB Atlas:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/anvaya?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/anvaya

# JWT Secret for Protected Admin Authentication
# Generate a secure random string (e.g. openssl rand -base64 32)
JWT_SECRET=anvaya_kit_secure_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=7d

# Initial Technical Administrator Bootstrap
# No hardcoded credentials required! Visit http://localhost:5173/admin/setup on first launch
# to create the initial Technical Administrator account with your verified details.

# Frontend / CORS Configuration
CLIENT_ORIGIN=http://localhost:5173
# For production frontend hosted on GitHub Pages or custom domain:
# CLIENT_ORIGIN=https://your-org.github.io

# Client Environment Variables (consumed by Vite)
# Note: Vite exposes variables prefixed with VITE_
VITE_API_BASE_URL=
# If deployed on GitHub Pages at https://<user>.github.io/<repo>/, set VITE_BASE_PATH=/<repo>/
VITE_BASE_PATH=/

# Media Storage Provider (Optional - Defaults to local storage in uploads/ folder)
# Provider options: local | cloudinary
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Provider Configuration (Optional - e.g. Brevo / SMTP for notifications)
# Provider options: none | smtp | brevo
EMAIL_PROVIDER=none
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=anvaya@kit-tiptur.ac.in
